    "from itertools import*\n",
    "k =0\n",
    "for x in product('01', repeat = 13 ):\n",
    "    a = ''.join(x)\n",
    "    if (a.count('1')+7)%2==0:\n",
    "        k+=1\n",
    "print(k)\n",
    "4096\n",
